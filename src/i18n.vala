/*
 * 中英文界面切换。
 *
 * 为什么不用 gettext：
 *
 *   1. gettext 要在构建链上加 xgettext/msgfmt，CI、AppImage、三个发行版包
 *      全得跟着装，而本机一个都没有。
 *   2. 翻译直接写成 Vala 常量表，编译进二进制。改一条翻译就是一个普通
 *      commit，PR diff 一眼能看懂；.po 还要多一道 msgfmt 代码生成。
 *   3. 本项目界面文案高度专有（AppImage / .desktop 术语），社区翻译的
 *      收益有限，自己维护反而更准。
 *
 * 缺翻译怎么办：
 *
 *   I18n.s() 查不到就原样返回中文 —— 界面上永远不会出现空白字符串。
 *   漏翻一条最多是那条还是中文，不会把界面搞坏。完整性由 selftest 兜底。
 *
 * 为什么不用 _() 这个 gettext 惯例：
 *
 *   _() 在 C 里长得像变量，读代码时分不清它是函数还是成员。I18n.s() 一眼可辨。
 */

public class I18n : GLib.Object {

    /** 界面语言 */
    public enum Lang {
        /** 跟随系统 locale（配置里是 auto 时的默认行为） */
        AUTO,
        /** 简体中文 */
        ZH,
        /** English */
        EN;

        public string to_config () {
            switch (this) {
                case ZH: return "zh";
                case EN: return "en";
                default: return "auto";
            }
        }

        public static Lang from_config (string? v) {
            if (v == "zh")
                return ZH;
            if (v == "en")
                return EN;
            return AUTO;
        }

        public string display_name () {
            switch (this) {
                case ZH: return "简体中文";
                case EN: return "English";
                default: return "跟随系统 (Follow system)";
            }
        }

        /**
         * 实际生效的语言。
         *
         * AUTO 在这里才落到具体语言 —— 界面各处问的都是「现在显示什么」，
         * 而不是「用户选了 auto 还是 zh」，这两件事内部必须分清。
         */
        public static Lang effective () {
            if (current == AUTO)
                return system_is_chinese () ? ZH : EN;
            return current;
        }

        /** 菜单里这个选项是不是正打在 radio 上的那一个 */
        public bool is_selected () {
            return this == effective ();
        }
    }

    /** 当前语言。main() 启动时从配置读出来定死，运行中不��。 */
    public static Lang current = Lang.AUTO;

    private static bool? cached_chinese = null;

    /**
     * 系统 locale 是不是中文。
     *
     * 依次看 LANGUAGE、LC_ALL、LC_MESSAGES、LANG —— 和 gettext 的优先级
     * 一致。第一个有值的说了算，不看后面优先级更低的。
     */
    public static bool system_is_chinese () {
        if (cached_chinese != null)
            return cached_chinese;

        bool zh = false;
        foreach (var name in new string[] { "LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG" }) {
            string? v = GLib.Environment.get_variable (name);
            if (v == null || v == "")
                continue;
            zh = v.index_of ("zh") >= 0 || v.index_of ("chinese") >= 0;
            break;   // 第一个有值的就定，后面的优先级更低，不再看
        }

        cached_chinese = zh;
        return zh;
    }

    /**
     * 中文 → English 翻译表，成对存放：中文、English、中文、English……
     *
     * 占位符（%d / %s / %.1f）的个数和类型必须与中文完全一致 ——
     * selftest 会逐条核对，这是防「译文占位符对不上导致 printf 越界」的
     * 唯一手段。
     */
    /**
     * 中文 → English 翻译表，成对存放：中文、English、中文、English……
     *
     * 靠 lazy_table() 惰性建表，**不能**写成静态字段的初始化器：
     * Vala 把静态初始化编译进类型系统里的类初始化，而本类从头到尾只被
     * 当静态方法命名空间用（I18n.s(...)），一次都没实例化过 —— 那段
     * 初始化代码永远不跑，表是空的。踩过一次：编译通过、自测跑起来
     * 「翻译表非空」直接失败。
     *
     * 占位符（%d / %s / %.1f）的个数和类型必须与中文完全一致 ——
     * selftest 会逐条核对，这是防「译文占位符对不上导致 printf 越界」的
     * 唯一手段。
     */
    private static string[]? lazy_table = null;

