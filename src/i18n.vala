    /**
     * 翻译一条界面文案。查不到就原样返回中文。
     *
     *     l.label = I18n.s ("重新扫描");
     *     show_info (I18n.s ("✓ 已提取 %d 个图标").printf (done));
     *
     * 带占位符的**先翻译再 printf**：printf 按译文里的 %d 取值，
     * 先 printf 就把中文填进去了，译文占位符对不上会直接炸。
     *
     * 中文模式下必须恒等 —— selftest 里有 400 多条断言直接比对中文字面量，
     * 只要恒等，一条都不用改。
     *
     * 这里用线性查找而不是 HashTable：全表 560 条，启动时总共查两百来次，
     * 560×200 次字符串比较不到一毫秒，换来的是少一层 GLib 容器依赖，
     * 也不用操心哈希函数和相等函数。
     */
    public static string s (string zh) {
        if (Lang.effective () == Lang.ZH)
            return zh;

        var tbl = table ();
        for (int i = 0; i + 1 < tbl.length; i += 2) {
            if (tbl[i] == zh) {
                string en = tbl[i + 1];
                return en != "" ? en : zh;
            }
        }
        return zh;   // 漏翻 / 空译文都退回中文，绝不返回空串
    }

    /** 翻译表的全部条目，供 selftest 校验覆盖率 */
    public static string[] all_entries () {
        return table ();
    }

    /** 某个中文串在表里有没有条目 —— selftest 扫源码时要跳过表本身 */
    public static bool is_in_table (string zh) {
        var tbl = table ();
        for (int i = 0; i + 1 < tbl.length; i += 2)
            if (tbl[i] == zh)
                return true;
        return false;
    }
}
